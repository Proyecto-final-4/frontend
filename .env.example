# Java backend base URL (server-side only)
BACKEND_JAVA_ENDPOINT=http://localhost:8080

# LangSmith — observability (opcional; el agente en finanzIA-agent puede usarlo)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=finance-app

# LangGraph server — URL donde corre el agente (finanzIA-agent)
# Local dev: `npm run dev` en agentes pf 4/finanzIA-agent (langgraphjs, puerto 2024)
# Producción: URL pública del servicio en Railway (ej: https://finanzIA-agent.up.railway.app)
LANGGRAPH_API_URL=http://localhost:2024

# Assistant ID — debe coincidir con la clave en langgraph.json del repo finanzIA-agent
LANGGRAPH_ASSISTANT_ID=financial_agent
